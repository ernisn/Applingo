<?xml version="1.0" encoding="utf-8"?>
<!--
  Android TV home screen banner (320 × 180 dp): the launcher logo on the launcher background. The
  foreground layer keeps its logo in the middle 66 of its 108 units, so at 180 dp the logo is 110 dp.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ic_launcher_background" />
            <size
                android:width="320dp"
                android:height="180dp" />
        </shape>
    </item>
    <item
        android:width="180dp"
        android:height="180dp"
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center" />
</layer-list>
